{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "cdg1"
  ],
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-snapshot",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "api/cron/daily-snapshot.ts": {
      "maxDuration": 60
    }
  }
}
